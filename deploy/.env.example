# Скопировать на ВМ в /opt/ghost-five/.env, выставить права 600 и заполнить.
DOMAIN=ghost-five.ru

# Образы: их подставляет деплой из GitHub Actions, тег — хеш коммита.
API_IMAGE=ghcr.io/ghost-five/backend:latest
WEB_IMAGE=ghcr.io/ghost-five/frontend:latest

# База. Пароль длинный и случайный: наружу порт не открыт, но пусть будет.
PGUSER=ghost
PGPASSWORD=
PGDATABASE=ghost_five

# Подпись токенов. Смена секрета разлогинивает всех — это нормально при утечке.
JWT_SECRET=

# Почта: подтверждение регистрации и сброс пароля.
SMTP_URL=smtps://логин%40yandex.ru:пароль_приложения@smtp.yandex.ru:465
SMTP_FROM=Ghost Five <логин@yandex.ru>
